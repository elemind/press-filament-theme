{
    "name": "elemind/press-filament-theme",
    "description": "Press is an editorial theme for Filament v5 in four editions, built on a horizontal rail instead of a sidebar.",
    "keywords": [
        "elemind",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-theme",
        "theme",
        "admin-panel",
        "top-navigation",
        "editorial",
        "press"
    ],
    "homepage": "https://github.com/elemind/press-filament-theme",
    "support": {
        "issues": "https://github.com/elemind/press-filament-theme/issues",
        "source": "https://github.com/elemind/press-filament-theme",
        "docs": "https://github.com/elemind/press-filament-theme#readme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "elemind",
            "email": "info@elemind.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Elemind\\PressFilamentTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elemind\\PressFilamentTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elemind\\PressFilamentTheme\\PressFilamentThemeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
